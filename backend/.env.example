PORT=3000
# Comma-separated browser origins. Required in production; unset allows local
# development clients on changing LAN addresses.
# CLIENT_ORIGIN=http://localhost:8080
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tinkerpro_sports
DB_USER=tinkerpro_api
DB_PASSWORD=replace-with-a-dedicated-database-password

SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-gmail-app-password

# Transactional SMS notifications through Twilio
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-with-a-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-sender-number

# Firebase Admin credentials for push delivery. Use either a service-account
# JSON file path or the JSON service-account content as an environment secret.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# PayMongo checkout integration
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret
PAYMONGO_SUCCESS_URL=http://localhost:8080/payment-success
PAYMONGO_CANCEL_URL=http://localhost:8080/payment-cancelled
